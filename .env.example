# Copy these into your hosting environment variables (or export them before `npm start`)
PORT=3000
ADMIN_PATH=/admin            # change to something private, e.g. /sc-team-portal
ADMIN_USER=admin             # used only on the very first start
ADMIN_PASSWORD=ChangeMe-12345  # used only on the very first start (min 8 chars). Leave empty to get a random one in the console.
COOKIE_SECURE=1              # set to 1 when the site runs on HTTPS (recommended)
TRUST_PROXY=1                # set to 1 when behind nginx / Cloudflare / a hosting proxy
DATA_DIR=./data              # where enquiries, site content and the admin login are stored
